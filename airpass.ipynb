    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.svm import SVR\n",
    "\n",
    "# --- Veri setini düzeltme ---\n",
    " data = pd.read_csv("airpassengers.csv", header=None),
    ")\n",
    "\n",
    "header = raw.iloc[0,0].replace('\"','').split(\",\")\n",
    "rows = raw.iloc[1:,0].str.replace('\"','').str.split(\",\", expand=True)\n",
    "data = pd.DataFrame(rows.values, columns=header)\n",
    "\n",
    "data[\"Month\"] = pd.to_datetime(data[\"Month\"])\n",
    "data[\"Passengers\"] = pd.to_numeric(data[\"Passengers\"])\n",
    "\n",
    "# Kolon adlarını sadeleştirelim\n",
    "data.columns = [\"month\",\"passengers\"]\n",
    "\n",
    "# --- 1. Zaman serisi grafiği ---\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(data[\"month\"], data[\"passengers\"])\n",
    "plt.title(\"AirPassengers - Yolcu Sayısı\")\n",
    "plt.xlabel(\"Tarih\")\n",
    "plt.ylabel(\"Yolcu\")\n",
    "plt.show()\n",
    "\n",
    "# --- 2. Aydan aya değişim ---\n",
    "data[\"mom_change\"] = data[\"passengers\"].diff()\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(data[\"month\"], data[\"mom_change\"])\n",
    "plt.title(\"AirPassengers - Aydan Aya Değişim\")\n",
    "plt.xlabel(\"Tarih\")\n",
    "plt.ylabel(\"Δ Yolcu\")\n",
    "plt.show()\n",
    "\n",
    "# --- 3. Ay bazında ortalama ---\n",
    "data[\"mon\"] = data[\"month\"].dt.month\n",
    "avg_by_month = data.groupby(\"mon\")[\"passengers\"].mean()\n",
    "labels = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"]\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.bar(labels, avg_by_month.values)\n",
    "plt.title(\"Ay Bazında Ortalama Yolcu\")\n",
    "plt.xlabel(\"Ay\")\n",
    "plt.ylabel(\"Ortalama Yolcu\")\n",
    "plt.show()\n",
    "\n",
    "# --- 4. SVR ile fit ---\n",
    "X = np.arange(len(data)).reshape(-1,1)\n",
    "y = data[\"passengers\"].values\n",
    "\n",
    "# parametreleri biraz gevşet (epsilon'u büyüt → daha düz fit)\n",
    "svr = SVR(kernel=\"rbf\", C=100, epsilon=10)\n",
    "svr.fit(X, y)\n",
    "data[\"svr_fit\"] = svr.predict(X)\n",
    "\n",
    "plt.figure(figsize=(12,6))\n",
    "plt.plot(data[\"month\"], data[\"passengers\"], label=\"Gerçek\")\n",
    "plt.plot(data[\"month\"], data[\"svr_fit\"], label=\"SVR Fit\", linewidth=2)\n",
    "plt.title(\"AirPassengers - SVR Fit (daha yumuşak)\")\n",
    "plt.xlabel(\"Tarih\")\n",
    "plt.ylabel(\"Yolcu\")\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
  },
